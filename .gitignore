# 会话/工具元数据
.omo/
.codegraph

# 密钥与凭据（绝不入库）
**/users_database.yml
**/initial-credentials.txt
**/*.crt
**/*.key
**/configuration.yml
admin/.admin-token
nginx/conf/generated/          # nginx 注入的共享密钥（admin token / FileBrowser 头名）

# 运行数据与日志
**/*.log
**/*.pid
**/data/
**/storages/
**/node_modules/
ports.json
dsh-users/registry.json        # 员工登记表属于运行数据，随部署漂移
admin/audit.log
**/*.bak.*                     # users_database.yml / config.yaml 的自动备份

# 无 root 安装的第三方二进制（由 scripts/install-bubblewrap.sh 生成）
bwrap/

# Python
__pycache__/
*.pyc
